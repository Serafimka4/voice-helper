# Тестовый стенд «Регистратура»
REGISTRY_BASE_URL=https://crm-med-mock.dbi-testing.ru/api/v1
# Токен команды. Пусто — ассистент работает на встроенном фейковом стенде
REGISTRY_TOKEN=
# Лимит стенда — 10 запросов в минуту на команду
REGISTRY_RATE_LIMIT=10

# Расписание врачей: JSON, импортированный из Excel кейса (python -m voice_helper.schedule)
SCHEDULE_PATH=data/schedule.json
KNOWLEDGE_BASE_PATH=data/knowledge_base.json
# Локальная БД: телефоны, журнал звонков, статусы напоминаний, карточки перевода
DB_PATH=data/voice_helper.sqlite

# LLM для разбора непонятых реплик — Claude через ClaudeHub (Anthropic-совместимый API).
# Пусто — работают только правила. В контуре заказчика заменить на локальную модель (152-ФЗ).
CLAUDEHUB_API_KEY=
CLAUDEHUB_BASE_URL=https://api.claudehub.fun
LLM_MODEL=claude-opus-5-5
